<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 12+ equivalent of backup_rules.xml — keep the two in step. See that file for why the
  file domain has to be named explicitly (DataStore does not use the sharedpref domain).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="condorino.db" />
        <include domain="file" path="datastore/" />
        <include domain="file" path="standby-prices-backup.json" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="condorino.db" />
        <include domain="file" path="datastore/" />
        <include domain="file" path="standby-prices-backup.json" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
